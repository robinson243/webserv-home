printf 'Content-Type: text/plain\r\n'
printf '\r\n'
printf 'mini cgi test\r\n'
printf 'REQUEST_METHOD=%s\r\n' "$REQUEST_METHOD"
printf 'QUERY_STRING=%s\r\n' "$QUERY_STRING"
printf 'CONTENT_TYPE=%s\r\n' "$CONTENT_TYPE"
printf 'CONTENT_LENGTH=%s\r\n' "$CONTENT_LENGTH"

if [ -n "$CONTENT_LENGTH" ] && [ "$CONTENT_LENGTH" -gt 0 ] 2>/dev/null; then
    BODY="$(dd bs=1 count="$CONTENT_LENGTH" 2>/dev/null)"
    printf 'BODY=%s\r\n' "$BODY"
else
    printf 'BODY=\r\n'
fi
